{
  "name": "eduba-brand",
  "version": "0.0.0",
  "private": true,
  "description": "Eduba design system — brand reference + @eduba/ui component library",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm --filter @eduba/ui build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "human-id": "^3.0.0"
    }
  }
}
