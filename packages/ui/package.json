{
  "name": "@eduba/ui",
  "version": "0.0.7",
  "description": "Eduba's brand-aligned React component library, built on Radix + Tailwind v4.",
  "keywords": [
    "eduba",
    "react",
    "components",
    "ui",
    "design-system",
    "component-library",
    "radix",
    "tailwindcss",
    "tailwind-v4",
    "headless",
    "accessible"
  ],
  "homepage": "https://ui.eduba.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banbury-cheese/eduba-brand.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/banbury-cheese/eduba-brand/issues"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "files": [
    "dist",
    "src/styles",
    "styles.css",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./chart": {
      "types": "./dist/components/chart.d.ts",
      "import": "./dist/components/chart.js"
    },
    "./data-table": {
      "types": "./dist/components/data-table.d.ts",
      "import": "./dist/components/data-table.js"
    },
    "./form": {
      "types": "./dist/components/form.d.ts",
      "import": "./dist/components/form.js"
    },
    "./styles.css": "./styles.css",
    "./base.css": "./src/styles/base.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-direction": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "embla-carousel-react": "^8.5.1",
    "input-otp": "^1.4.1",
    "lucide-react": "^0.469.0",
    "react-day-picker": "^9.4.4",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.20.5",
    "gsap": "^3.13.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
